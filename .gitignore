# ===========================
# OptiBoard v5 - .gitignore
# ===========================

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
*.log

# Node / React
node_modules/
dist/
build/
.cache/
*.local
reporting-commercial/frontend/dist/
reporting-commercial/frontend/build/
reporting-commercial/frontend/dist.zip

# .NET / C#
SageETLAgent_MultiAgent/**/bin/
SageETLAgent_MultiAgent/**/obj/
SageETLAgent_MultiAgent/publish/
SageETLAgent_MultiAgent/publish_out/
SageETLAgent_MultiAgent/**/binpublish*/
*.user
*.suo
.vs/

# Installer (artefacts de build)
# NB: installer/payload/backend/ N'est PAS ignore (squelette versionne) ;
# les artefacts Cython (*.pyd, *.pyc) y sont deja couverts par les motifs Python.
installer/cache/
installer/output/
installer/payload/python/
installer/payload/frontend/
installer/payload/nssm.exe
tmpclaude-*

# Backend - fichiers d'etat / sorties temporaires
reporting-commercial/backend/.license_cache
.license_cache
reporting-commercial/backend/_err.txt
reporting-commercial/backend/_out.txt
reporting-commercial/backend/dist_client/
tmp_*.py

# Claude Code
.claude/worktrees/

# Docker
*.pid

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*

# SQL Server data (never commit DB data)
sqlserver/data/
sqlserver/*.bak

# Configs agent contenant des secrets (clé API en clair) — ne jamais committer
agent_config_*.json
