# ======================================================================
#  OptiBoard - Configuration
#  Modifiez les valeurs ci-dessous selon votre environnement puis
#  redemarrez le service OptiBoard-Backend (Services Windows ou stop_backend.bat)
# ======================================================================

# --- Base de donnees SQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=OptiBoard
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# --- Serveur API ---
API_HOST=0.0.0.0
API_PORT=8084
DEBUG=False

# URL publique routable du backend, telle que les AGENTS ETL doivent la joindre
# (ex: https://optiboard.kasoft.ma). Obligatoire pour generer les fichiers de
# configuration agent : sans elle, l'URL est deduite du header Host de l'admin
# qui telecharge le fichier, ce qui produit un http://127.0.0.1:8084 injoignable
# depuis le poste client (l'agent tenterait de joindre sa propre machine).
SERVER_PUBLIC_URL=

# --- Securite ---
# IMPORTANT: generez une cle aleatoire unique par installation
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Licence OptiBoard ---
LICENSE_KEY=
LICENSE_SERVER_URL=https://license.kasoft.ma/api
# IMPORTANT: secret par installation — generez avec: openssl rand -hex 32
LICENSE_SIGNING_SECRET=CHANGE_ME__generer_avec_openssl_rand_-hex_32

# --- Email SMTP (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=optiboard@example.com
SMTP_TLS=True

# --- IA (optionnel) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4

# --- CORS (domaines autorises) ---
CORS_ORIGINS=http://localhost:8084,http://localhost:3000
