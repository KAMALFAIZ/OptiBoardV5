# ============================================================
# OptiBoard v5 — Variables d'environnement Production
# Copier ce fichier en .env sur le serveur et remplir les valeurs
# NE JAMAIS committer le fichier .env avec de vraies valeurs !
# ============================================================

# ── GitHub ───────────────────────────────────────────────
GITHUB_OWNER=kamalfaiz

# ── Base de données SQL Server ────────────────────────────
DB_SERVER=IP_DU_SERVEUR_SQL ou nom_du_service
DB_NAME=GROUPE_ALBOUGHAZE
DB_USER=sa
DB_PASSWORD=MOT_DE_PASSE_FORT_ICI

# ── Application ──────────────────────────────────────────
SECRET_KEY=CHAINE_ALEATOIRE_TRES_LONGUE_64_CHARS
DEBUG=False
CACHE_TTL=300
MAX_ROWS=10000
QUERY_TIMEOUT=30

# ── CORS (domaine(s) autorisé(s)) ────────────────────────
ALLOWED_ORIGINS=https://votre-domaine.com

# ── Email (si notifications activées) ───────────────────
MAIL_SERVER=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=email@exemple.com
MAIL_PASSWORD=MOT_DE_PASSE_EMAIL
MAIL_FROM=optiboard@exemple.com

# ── Routing SaaS multi-tenant (parc KASOFT) ──────────────
# En SaaS, le DWH est resolu depuis le sous-domaine {code}.kasoft.ma.
# NE PAS definir STANDALONE_MODE ni DWH_CODE en SaaS (sinon retombe sur le DWH par defaut).
BASE_DOMAIN=kasoft.ma
# Frontend (au build, cote crm/reporting-commercial frontend) : VITE_BASE_DOMAIN=kasoft.ma

# ── Console KASOFT (monitoring + licence unifiee) ────────
# Token de service partage avec la console : active GET /api/console/instance-stats.
# Vide (defaut) = endpoint desactive (404). Doit etre IDENTIQUE au token saisi dans la fiche console.
CONSOLE_TOKEN=
# Licence JWT RS256 signee par la console (verifiee hors-ligne par app/license-public.pem).
# Prioritaire sur le repli HMAC ci-dessous ; une fois en place, le serveur de licence externe devient superflu.
LICENSE_KEY=
# Version exposee dans instance-stats (sinon "dev").
APP_VERSION=

# ── License Server (repli HMAC legacy — superflu si LICENSE_KEY JWT pose) ──
LICENSE_SERVER_URL=https://license.kasoft.ma/api
LICENSE_SIGNING_SECRET=CHANGE_ME__generer_avec_openssl_rand_-hex_32
